{
  "name": "odin-api",
  "version": "2.0.0",
  "description": "Odin api.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "predev": "npm run prettier",
    "prettier": "prettier --single-quote --trailing-comma es5 --write \"./**/*.js\"",
    "prettier:check": "prettier --check 'src/**/*.js'",
    "lint": "eslint 'src/**/*.js' --fix",
    "dev": "nodemon -r dotenv/config ./src/server.js dotenv_config_path=./.env.local --ignore ./src/models",
    "test": "cross-env ENV=test APP_ENVIRONMENT=test mocha test/**/*.test.js test/**/**/*.test.js",
    "test:coverage": "c8 --allowExternal npm run test",
    "prod": "node -r dotenv/config index.js dotenv_config_path=./.env.prod"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "c8": {
    "all": true,
    "reporter": [
      "lcov",
      "json",
      "text"
    ],
    "exclude": [
      "**/src/models/*.js",
      "**/*.test.js",
      "coverage/**/*.js",
      "**/src/routes/*.js",
      "**/src/routes/**/*.js",
      "**/src/modules/router.module.js",
      "**/src/config/db.config.js",
      "**/src/middlewares/winston.js",
      "**/src/server.js",
      "**/src/app.js"
    ],
    "report-dir": "./coverage",
    "extension": [
      ".js"
    ],
    "sourceMap": true,
    "instrument": true,
    "branches": 97,
    "lines": 97,
    "functions": 97,
    "statements": 97
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odin-oss/monolith-api.git"
  },
  "author": "Benoit Lefebvre",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/odin-oss/monolith-api/issues"
  },
  "homepage": "https://github.com/odin-oss/monolith-api#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-winston": "^4.2.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.1.14",
    "npm": "^11.11.0",
    "path-to-regexp": "^8.3.0",
    "pg": "^8.19.0",
    "prettier": "^3.8.1",
    "prom-client": "^15.1.3",
    "sequelize": "^6.37.7",
    "sequelize-auto": "^0.8.8",
    "swagger-autogen": "^2.23.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "c8": "^11.0.0",
    "chai": "^6.2.2",
    "cross-env": "^10.1.0",
    "esm": "^3.2.25",
    "mocha": "^11.7.5",
    "nyc": "^18.0.0",
    "sinon": "^21.0.1",
    "sinon-chai": "^4.0.1"
  }
}
