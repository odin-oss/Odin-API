{
  "name": "odin-api",
  "version": "2.0.0",
  "description": "Odin api.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "predev": "npm run prettier",
    "prettier": "prettier --single-quote --trailing-comma es5 --write \"./**/*.js\"",
    "prettier:check": "prettier --check 'src/**/*.js'",
    "lint": "eslint 'src/**/*.js' --fix",
    "dev": "nodemon -r dotenv/config ./src/server.js dotenv_config_path=./.env.local --ignore ./src/models",
    "test": "cross-env ENV=test mocha test/**/*.test.js test/**/**/*.test.js",
    "test:coverage": "c8 --allowExternal npm run test",
    "prod": "node -r dotenv/config index.js dotenv_config_path=./.env.prod"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "c8": {
    "all": true,
    "reporter": [
      "lcov",
      "json",
      "text"
    ],
    "exclude": [
      "**/*.test.js",
      "index.js",
      "prerequisites.js",
      "swagger.js",
      "coverage/**/*.js",
      "**/config/models-*/*.js",
      "**/src/routes/*.js",
      "**/src/routes/**/*.js",
      "**/src/modules/router.module.js",
      "**/src/config/db-init.config.js",
      "**/src/config/db.config.js",
      "**/src/config/winston.config.js",
      "**/src/utils/health.service.js"
    ],
    "report-dir": "./coverage",
    "extension": [
      ".js"
    ],
    "sourceMap": true,
    "instrument": true,
    "branches": 97,
    "lines": 97,
    "functions": 97,
    "statements": 97
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/caelus-team/application-cirrus/ms-api.git"
  },
  "author": "Benoit Lefebvre",
  "license": "ISC",
  "bugs": {
    "url": "https://gitlab.com/caelus-team/application-cirrus/ms-api/issues"
  },
  "homepage": "https://gitlab.com/caelus-team/application-cirrus/ms-api#readme",
  "dependencies": {
    "@hapi/joi": "^17.1.1",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.1",
    "chai": "^5.1.2",
    "chai-http": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-winston": "^4.2.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.46",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "npm": "^11.6.0",
    "openid-client": "^6.1.6",
    "passport": "^0.7.0",
    "pg": "^8.8.0",
    "prettier": "^3.4.1",
    "prom-client": "^15.1.3",
    "sequelize": "^6.25.0",
    "sequelize-auto": "^0.8.8",
    "swagger-autogen": "^2.22.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.8.2",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "chai": "^5.2.0",
    "cross-env": "^7.0.3",
    "esm": "^3.2.25",
    "mocha": "^11.1.0",
    "nyc": "^17.1.0",
    "sinon": "^19.0.2",
    "sinon-chai": "^4.0.0"
  }
}
